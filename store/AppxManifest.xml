<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store 打包清单模板：本文件由 CI 注入 Partner Center 产品标识后打包，
  占位符列表与替换逻辑见 .github/workflows/store-release.yml 的
  "Validate packaging inputs" 与 "Package as MSIX" 步骤。
  注意：本文件必须以无 BOM 的 UTF-8 读写，否则下方 DisplayName/Description 的中文会损坏。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__" />

  <Properties>
    <DisplayName>QuantDesktop</DisplayName>
    <PublisherDisplayName>Leaderxin</PublisherDisplayName>
    <Logo>StoreLogo.png</Logo>
    <!-- 有意不声明 desktop6:FileSystemWriteVirtualization / RegistryWriteVirtualization。
         它们能让数据库/日志写进真实的 %APPDATA%\quant-desktop，与 NSIS/便携版共享
         同一份数据、且卸载商店包不删用户数据；但 schema 强制要求配套声明
         unvirtualizedResources 受限能力，而该能力在 2026-09 的提交中被商店驳回
         （政策 10.6.3），理由是低权限替代方案（默认虚拟化）已经足够。微软文档本身
         也不推荐该属性：它整体关闭虚拟化，并非细粒度手段，通常超出应用实际需求
         （Windows 11 的细粒度写法同样需要该能力，绕不开审批）。
         维持默认虚拟化后，OS 在文件系统层拦截写入并重定向到包私有目录
         （%LOCALAPPDATA%\Packages\「包族名」\LocalCache\Roaming\...），app 视角仍是
         %APPDATA%\quant-desktop，Rust 侧无需任何改动。代价：商店版与 NSIS 版数据
         独立、卸载商店包会删数据 —— 属商店应用的正常预期行为；跨版本搬运自选走
         JSON/CSV 导入导出。 -->
  </Properties>

  <Dependencies>
    <!-- MinVersion 19041（Win10 2004）：该基线起系统普遍预装 WebView2 Evergreen
         运行时。商店构建不内嵌 WebView2（MSIX 管道不会执行 MSI 的安装动作，
         见 tauri.microsoftstore.conf.json 的 webviewInstallMode: skip），
         因此不支持更早的系统 —— 1809 等旧系统会从商店拿到一个无法启动的应用。 -->
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <Application
      Id="QuantDesktop"
      Executable="quant-desktop.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="QuantDesktop - 免费实时A股看盘"
        Description="A股实时行情桌面监测工具"
        Square150x150Logo="Square150x150Logo.png"
        Square44x44Logo="Square44x44Logo.png"
        BackgroundColor="transparent" />
      <Extensions>
        <!-- 打包应用的开机自启：声明 StartupTask（默认关闭，应用内开关通过 WinRT
             StartupTask API 启用，见 src-tauri/src/commands/autostart.rs）。
             相比注册表 Run 键：路径由系统按包标识解析，Store 更新后依然有效，
             且在任务管理器「启动」页可见、可由用户在系统层面管理。
             TaskId 必须与 autostart.rs 中的 TASK_ID 常量一致。 -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask
            TaskId="QuantDesktop"
            Enabled="false"
            DisplayName="QuantDesktop" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
