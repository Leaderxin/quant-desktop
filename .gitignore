# Website build product — assembled from public/ and src-tauri/icons by
# scripts/site-assets.mjs. Never edit by hand; it is regenerated and deleted.
website/assets/
# Copied from docs/privacy.html so the Microsoft Store's privacy-policy URL
# (…github.io/quant-desktop/privacy.html) survives the switch to Actions.
website/privacy.html
# sitemap.xml 由 scripts/site-assets.mjs 按实际页面生成（含 git 取到的 lastmod），
# 手维护的话加了页面必然忘记登记。
website/sitemap.xml

